---
import { site } from '../data/site';
import { hoursSummary } from '../lib/hours';
import { waLink } from '../lib/whatsapp';
import Icon from './Icon.astro';
---

<section class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <span class="status" data-status="long"><i></i><span data-status-text>{hoursSummary(site.hours)}</span></span>
      <h1>Som, película e LED com <em>acabamento de fábrica.</em></h1>
      <p class="lead">
        Multimídia, insulfilme, iluminação e acessórios instalados por quem faz isso todos os dias, no {site.address.district} de {site.address.city}.
        Chame no WhatsApp, agende o horário e retire o carro pronto.
      </p>
      <div class="hero-actions">
        <a class="btn btn-amber" href={waLink()} target="_blank" rel="noopener">
          <Icon name="arrow" />
          Pedir orçamento no WhatsApp
        </a>
        <a class="btn btn-ghost" href="#servicos">Ver serviços</a>
      </div>
      <dl class="spec">
        <div><dt>Atendimento</dt><dd>{hoursSummary(site.hours, ' · ')}</dd></div>
        <div><dt>Telefone</dt><dd>{site.phone.display}</dd></div>
        <div><dt>Endereço</dt><dd>{site.address.street} · {site.address.city}</dd></div>
      </dl>
    </div>

    <div class="hero-art" aria-hidden="true">
      <svg viewBox="20 40 785 290">
        <defs>
          <linearGradient id="hero-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2E353C" /><stop offset=".55" stop-color="#1C2126" /><stop offset="1" stop-color="#111417" />
          </linearGradient>
          <linearGradient id="hero-glass" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#3A444D" /><stop offset="1" stop-color="#0B0D0F" />
          </linearGradient>
          <radialGradient id="hero-beam" cx="0" cy=".5" r="1">
            <stop offset="0" stop-color="#FFF4D6" stop-opacity=".85" /><stop offset=".25" stop-color="#F2D58A" stop-opacity=".35" /><stop offset="1" stop-color="#F2A900" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="hero-floor" cx=".5" cy=".5" r=".5">
            <stop offset="0" stop-color="#F2A900" stop-opacity=".18" /><stop offset="1" stop-color="#F2A900" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="hero-rim" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#6B757E" stop-opacity="0" /><stop offset=".5" stop-color="#9AA4AD" /><stop offset="1" stop-color="#6B757E" stop-opacity=".2" />
          </linearGradient>
        </defs>
        <ellipse cx="420" cy="292" rx="380" ry="26" fill="url(#hero-floor)" class="glow" />
        <ellipse cx="410" cy="286" rx="330" ry="10" fill="#000" opacity=".55" />
        <path d="M752 188 L800 150 L800 250 Z" fill="url(#hero-beam)" class="glow" />
        <path d="M58 214 C58 192 70 178 96 172 L212 160 C252 122 302 98 382 95 L520 95 C572 95 612 122 652 156 L722 166 C746 170 758 186 758 206 L758 226 C758 234 752 240 744 240 L692 240 A57 57 0 0 0 578 240 L272 240 A57 57 0 0 0 158 240 L74 240 C64 240 58 233 58 224 Z" fill="url(#hero-body)" />
        <path d="M214 160 C254 122 304 98 382 95 L520 95 C572 95 612 122 652 156" fill="none" stroke="url(#hero-rim)" stroke-width="1.5" />
        <path d="M90 190 L740 182" stroke="#4A535B" stroke-width="1" opacity=".7" />
        <path d="M236 158 C268 126 310 111 374 109 L440 109 L440 158 Z" fill="url(#hero-glass)" />
        <path d="M452 109 L516 109 C556 109 590 128 620 156 L452 158 Z" fill="url(#hero-glass)" />
        <path d="M300 125 L330 115" stroke="#fff" stroke-opacity=".12" stroke-width="6" stroke-linecap="round" />
        <path d="M478 120 L520 116" stroke="#fff" stroke-opacity=".1" stroke-width="5" stroke-linecap="round" />
        <path d="M446 160 L446 236 M296 162 L300 236" stroke="#0A0C0E" stroke-width="1.5" />
        <rect x="398" y="176" width="22" height="4" rx="2" fill="#4A535B" />
        <rect x="560" y="174" width="22" height="4" rx="2" fill="#4A535B" />
        <path d="M612 150 L634 146 L636 158 L616 160 Z" fill="#20262B" />
        <path d="M716 176 L748 180 C752 181 754 184 753 188 L716 186 Z" fill="#FFF3D1" class="glow" />
        <path d="M712 194 L748 196" stroke="#F2A900" stroke-width="2.5" stroke-linecap="round" class="glow" />
        <path d="M60 186 L92 180 L92 190 L60 196 Z" fill="#C2361F" />
        <path d="M60 191 L30 186 L30 200 Z" fill="#C2361F" opacity=".15" />
        {[215, 635].map((cx) => (
          <g>
            <circle cx={cx} cy="240" r="47" fill="#0A0C0E" />
            <circle cx={cx} cy="240" r="31" fill="#1E2328" stroke="#5E6870" stroke-width="2" />
            <g stroke="#5E6870" stroke-width="3"><path d={`M${cx} 211v58M${cx - 29} 240h58M${cx - 20} 220l40 40M${cx + 20} 220l-40 40`} /></g>
            <circle cx={cx} cy="240" r="7" fill="#9AA4AD" />
          </g>
        ))}
        <g font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="1.2" fill="#8E979F">
          <path d="M380 130 L380 60 L330 60" stroke="#3A424A" fill="none" /><circle cx="380" cy="130" r="3" fill="#F2A900" />
          <text x="250" y="56">INSULFILME G20</text>
          <path d="M736 182 L736 60 L700 60" stroke="#3A424A" fill="none" /><circle cx="736" cy="182" r="3" fill="#F2A900" />
          <text x="640" y="56">ULTRA LED</text>
          <path d="M560 190 L560 316 L520 316" stroke="#3A424A" fill="none" /><circle cx="560" cy="190" r="3" fill="#F2A900" />
          <text x="402" y="320">MULTIMÍDIA + SOM</text>
        </g>
      </svg>
    </div>
  </div>
</section>

<script>
  import '../scripts/store-status';
</script>

<style>
  .hero { background: var(--night); color: var(--night-ink); position: relative; overflow: hidden; }
  .hero::after { content: ""; position: absolute; inset: auto 0 0; height: 1px; background: var(--night-line); }
  .wrap { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; padding-block: 72px 56px; }
  .hero-copy { min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  h1 { font-size: clamp(38px, 5.6vw, 68px); line-height: .98; font-weight: 800; font-stretch: 112%; letter-spacing: -.01em; text-transform: uppercase; }
  h1 em { font-style: normal; color: var(--amber); }
  .lead { font-size: 18px; color: var(--night-muted); max-width: 34em; margin: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }

  .status {
    display: inline-flex; align-items: center; gap: 10px; align-self: flex-start;
    font: 500 13px/1 var(--f-mono); color: var(--night-ink);
    border: 1px solid var(--night-line); background: var(--night-2);
    padding: 9px 14px; border-radius: 999px;
  }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: var(--night-muted); flex: none; }
  .status.is-open i { background: #3DD07F; box-shadow: 0 0 0 4px rgba(61, 208, 127, .15); }
  .status.is-closed i { background: #E0765F; }

  .hero-art { min-width: 0; position: relative; }
  .hero-art svg { width: 100%; height: auto; display: block; }

  .spec { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--night-line); margin: 8px 0 0; }
  .spec div { padding: 16px 16px 0 0; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .spec div + div { padding-left: 16px; border-left: 1px solid var(--night-line); }
  .spec dt { font: 500 11px/1.2 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--night-muted); }
  .spec dd { margin: 0; font: 700 15px/1.3 var(--f-body); overflow-wrap: anywhere; }

  .glow { animation: glow 2.8s ease-out 1 both; }
  @keyframes glow { 0% { opacity: .25; } 35% { opacity: 1; } 55% { opacity: .7; } 100% { opacity: .9; } }

  @media (max-width: 880px) {
    .wrap { grid-template-columns: 1fr; padding-block: 48px 40px; gap: 28px; }
    .hero-art { order: -1; max-width: 560px; }
  }
  @media (max-width: 520px) {
    .spec { grid-template-columns: 1fr; }
    .spec div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--night-line); padding-top: 12px; }
    .spec div { padding-top: 12px; }
  }
</style>
