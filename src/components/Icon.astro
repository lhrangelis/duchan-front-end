---
// Ícones SVG inline (decorativos: sempre aria-hidden).
export type IconName = 'whatsapp' | 'arrow' | 'navigate' | 'phone' | 'instagram' | 'facebook' | 'som' | 'insulfilme' | 'iluminacao' | 'acessorios';

interface Props {
  name: IconName;
  class?: string;
}

const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': '1.6', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
const bold = { ...stroke, 'stroke-width': '2' };
const solid = { fill: 'currentColor' };

const icons: Record<IconName, { attrs: Record<string, string>; body: string }> = {
  whatsapp: {
    attrs: solid,
    body: '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/>',
  },
  arrow: { attrs: bold, body: '<path d="M5 12h14M13 6l6 6-6 6"/>' },
  navigate: { attrs: bold, body: '<path d="M3 11 21 3l-8 18-2-8Z"/>' },
  phone: { attrs: stroke, body: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>' },
  instagram: {
    attrs: { fill: 'none', stroke: 'currentColor', 'stroke-width': '1.6' },
    body: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>',
  },
  facebook: { attrs: stroke, body: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5a.5.5 0 0 1 .5-.5"/>' },
  som: { attrs: stroke, body: '<rect x="5" y="2.5" width="14" height="19" rx="2"/><circle cx="12" cy="14.5" r="4"/><circle cx="12" cy="14.5" r="1"/><circle cx="12" cy="6.5" r="1.4"/>' },
  insulfilme: { attrs: stroke, body: '<path d="M3 18 6 6h12l3 12Z"/><path d="M8.5 6 6.8 18M15.5 6l1.7 12" opacity=".5"/><path d="M4.5 12h15" opacity=".5"/>' },
  iluminacao: { attrs: stroke, body: '<path d="M9 6c-3 0-5 2.7-5 6s2 6 5 6h2V6Z"/><path d="M15 8h6M15 12h6M15 16h6"/>' },
  acessorios: { attrs: stroke, body: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/>' },
};

const { name, class: className } = Astro.props;
const icon = icons[name];
---

<svg viewBox="0 0 24 24" aria-hidden="true" class={className} {...icon.attrs} set:html={icon.body} />
