---
import { fullAddress, site } from '../data/site';
import Icon from './Icon.astro';

const q = encodeURIComponent(fullAddress);
const mapsSearch = `https://www.google.com/maps/search/?api=1&query=${q}`;
const mapsDirections = `https://www.google.com/maps/dir/?api=1&destination=${q}`;
---

<section class="block flush-top" id="localizacao">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">Localização</p>
        <h2>Venha até a loja</h2>
      </div>
      <p>Estamos na {site.address.street.split(',')[0]}, no {site.address.district} de {site.address.city}. Use o botão abaixo para traçar a rota direto no Google Maps.</p>
    </div>
    <div class="loc">
      <!-- TODO (P2): trocar a ilustração por um mapa real carregado só no clique. -->
      <a class="map" href={mapsSearch} target="_blank" rel="noopener" aria-label="Abrir a localização no Google Maps">
        <svg viewBox="0 0 600 340" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <rect width="600" height="340" fill="#15191D" />
          <g fill="#1C2126">
            <rect x="20" y="20" width="150" height="90" rx="4" /><rect x="200" y="20" width="170" height="90" rx="4" /><rect x="400" y="20" width="180" height="90" rx="4" />
            <rect x="20" y="230" width="150" height="90" rx="4" /><rect x="200" y="230" width="170" height="90" rx="4" /><rect x="400" y="230" width="180" height="90" rx="4" />
            <rect x="20" y="140" width="150" height="60" rx="4" /><rect x="400" y="140" width="180" height="60" rx="4" />
          </g>
          <rect x="420" y="240" width="140" height="70" rx="4" fill="#1E3A2A" opacity=".8" />
          <g stroke="#2C333A" stroke-width="10"><path d="M0 125H600M0 215H600M185 0V340M385 0V340" /></g>
          <path d="M0 125H600" stroke="#F7BF00" stroke-opacity=".55" stroke-width="12" />
          <text x="28" y="152" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="1.5" fill="#8E979F">{site.address.street.split(',')[0].toUpperCase()}</text>
          <g transform="translate(300 125)">
            <circle r="34" fill="#F7BF00" opacity=".12" /><circle r="18" fill="#F7BF00" opacity=".22" />
            <path d="M0 -6 C-14 -6 -22 -18 -22 -30 A22 22 0 0 1 22 -30 C22 -18 14 -6 0 -6Z" fill="#F7BF00" transform="translate(0 6)" />
            <circle cy="-24" r="8" fill="#0E1114" />
          </g>
          <text x="300" y="168" text-anchor="middle" font-family="Instrument Sans, sans-serif" font-weight="600" font-size="14" fill="#ECEEEF">{site.name}</text>
        </svg>
        <span class="hint">Abrir mapa ↗</span>
      </a>
      <div class="loc-info">
        <p class="eyebrow">Endereço</p>
        <address>
          {site.address.street} – {site.address.district}
          <span>{site.address.city} – {site.address.state} · CEP {site.address.postalCode}</span>
        </address>
        <button class="copy" type="button" data-copy={fullAddress}>Copiar endereço</button>
        <div class="loc-actions">
          <a class="btn btn-amber" href={mapsDirections} target="_blank" rel="noopener">
            <Icon name="navigate" />
            Como chegar
          </a>
          <a class="btn btn-line" href={mapsSearch} target="_blank" rel="noopener">Ver no Google Maps</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    const original = btn.textContent;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const flash = (text: string) => {
      btn.textContent = text;
      clearTimeout(timer);
      timer = setTimeout(() => (btn.textContent = original), 2500);
    };
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        flash('Endereço copiado ✓');
      } catch {
        // Sem acesso à área de transferência: seleciona o texto para o usuário copiar.
        const address = btn.parentElement?.querySelector('address');
        if (address) getSelection()?.selectAllChildren(address);
        flash('Selecionado — use Ctrl+C para copiar');
      }
    });
  }
</script>

<style>
  .loc { display: grid; grid-template-columns: 1.4fr 1fr; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; background: var(--surface); }
  .map { position: relative; min-height: 340px; background: var(--night); display: block; text-decoration: none; }
  .map svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hint { position: absolute; right: 14px; bottom: 14px; font: 500 12px/1 var(--f-mono); letter-spacing: .06em; background: var(--amber); color: var(--on-amber); padding: 9px 12px; border-radius: 999px; }
  .loc-info { padding: 32px; display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  address { font-style: normal; font-size: 20px; line-height: 1.35; font-weight: 600; }
  address span { display: block; color: var(--muted); font-size: 15px; font-weight: 400; margin-top: 6px; }
  .loc-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; }
  .copy { align-self: flex-start; font: 500 13px/1 var(--f-mono); background: none; border: 0; padding: 0; color: var(--muted); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 820px) { .loc { grid-template-columns: 1fr; } .map { min-height: 260px; } }
</style>
