---
import { waLink } from '../lib/whatsapp';
---

<section class="cta">
  <div class="wrap">
    <h2>Mande o modelo do seu carro e receba o orçamento</h2>
    <a class="btn" href={waLink()} target="_blank" rel="noopener">Chamar no WhatsApp →</a>
  </div>
</section>

<style>
  .cta { background: var(--amber); color: var(--on-amber); }
  .wrap { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-block: 48px; }
  h2 { font-size: clamp(26px, 3.4vw, 40px); font-weight: 800; font-stretch: 112%; text-transform: uppercase; line-height: 1.02; max-width: 18em; }
  .btn { background: var(--on-amber); color: #F7F4EC; }
  .btn:hover { background: #000; }
</style>
