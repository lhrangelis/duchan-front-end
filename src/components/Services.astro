---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="block" id="servicos">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">Serviços</p>
        <h2>Tudo o que o seu carro precisa, numa loja só</h2>
      </div>
      <p>Trabalhamos com marcas de mercado e instalação feita com o chicote certo, sem cortes na fiação original. Você sai sabendo o que foi instalado e como usar.</p>
    </div>

    <div class="services">
      {site.services.map((s) => (
        <article class="svc">
          <span class="ico"><Icon name={s.icon} /></span>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          <ul>
            {s.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); overflow: hidden; }
  .svc { padding: 28px 24px 30px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .svc + .svc { border-left: 1px solid var(--line); }
  .ico { width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--line); display: grid; place-items: center; color: var(--ink); }
  .ico :global(svg) { width: 22px; height: 22px; }
  h3 { font-size: 22px; font-weight: 750; font-stretch: 108%; text-transform: uppercase; letter-spacing: .01em; }
  .svc p { margin: 0; color: var(--muted); font-size: 15px; }
  ul { list-style: none; margin: 4px 0 0; padding: 14px 0 0; border-top: 1px dashed var(--line); display: flex; flex-direction: column; gap: 8px; font-size: 14.5px; }
  li { display: flex; gap: 10px; align-items: baseline; }
  li::before { content: ""; width: 6px; height: 6px; flex: none; background: var(--amber); border-radius: 1px; transform: translateY(-2px); }
  @media (max-width: 1000px) {
    .services { grid-template-columns: repeat(2, 1fr); }
    .svc:nth-child(3) { border-left: 0; }
    .svc:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .services { grid-template-columns: 1fr; }
    .svc + .svc { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
